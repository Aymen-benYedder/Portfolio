---
// AsciiGlobe.astro
// Pixel-block name — "AYMEN" in emerald / "ben Yedder" in gray.
// DOM-based pixel grid animated with Anime.js v3 using the MCP's ready-made
// patterns: stagger-grid (scale/opacity/translateY from center, easeOutBack)
// and timeline-sequence (AYMEN then ben Yedder).
// Respects prefers-reduced-motion.

interface Props {
  width?: string;
  height?: string;
  accent?: string;
  gray?: string;
  fontFamily?: string;
  firstFont?: number;       // Offscreen render font size for "AYMEN" (smaller = chunkier blocks)
  baseFont?: number;        // Offscreen render font size for "ben Yedder"
  blockRatio?: number;      // Fraction of container width used for block computation
  blockScale?: number;      // Multiplier on computed block size (1 = fit container, 2 = 2x bigger)
  pixelGap?: number;        // Gap in px between each pixel block (0 = solid)
  rowGapRatio?: number;     // Gap between lines as fraction of first block size
  staggerMs?: number;       // Stagger spacing per grid step (default 60)
}

const {
  width = "100%",
  height = "auto",
  accent = "#34d399",
  gray = "#6b7280",
  fontFamily = "JetBrains Mono",
  firstFont = 45,
  baseFont = 18,
  blockRatio = 0.88,
  blockScale = 1,
  pixelGap = 1,
  rowGapRatio = 0.6,
  staggerMs = 60,
} = Astro.props;
---

<div class="ascii-globe-wrap" style={`width: ${width}; ${height !== 'auto' ? `height: ${height};` : ''}`}>
  <div id="ascii-globe" class="ascii-globe"
    data-accent={accent}
    data-gray={gray}
    data-font={fontFamily}
    data-first-font={firstFont}
    data-base-font={baseFont}
    data-block-ratio={blockRatio}
    data-block-scale={blockScale}
    data-pixel-gap={pixelGap}
    data-row-gap-ratio={rowGapRatio}
    data-stagger-ms={staggerMs}
  ></div>
</div>

<style>
  .ascii-globe-wrap {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    background-color: transparent;
    overflow: hidden;
  }
  .ascii-globe {
    position: relative;
    --bs1: 12px;
    --bs2: 9px;
    --gap: 1px;
  }
  .ascii-globe .line {
    position: absolute;
    top: 0;
    left: 0;
  }
  .ascii-globe .pixel {
    position: absolute;
    width: calc(var(--bs) - var(--gap));
    height: calc(var(--bs) - var(--gap));
    left: calc(var(--bs) * var(--c));
    top: calc(var(--bs) * var(--r));
    background: var(--pc);
    opacity: 0;
  }
</style>

<script>
  import anime from 'animejs/lib/anime.es.js';

  // ─── Render text to binary pixel grid ───
  function textToGrid(text, fontSize, fontFam, bold) {
    const ca = document.createElement('canvas');
    const cx = ca.getContext('2d');
    if (!cx) return null;

    const weight = bold ? '800' : '400';
    cx.font = `${weight} ${fontSize}px "${fontFam}", monospace`;
    const m = cx.measureText(text);
    const w = Math.max(1, Math.ceil(m.width) + 4);
    const h = Math.ceil(fontSize * 1.4);

    ca.width = w;
    ca.height = h;
    cx.clearRect(0, 0, w, h);
    cx.font = `${weight} ${fontSize}px "${fontFam}", monospace`;
    cx.fillStyle = '#fff';
    cx.textBaseline = 'top';
    cx.fillText(text, 0, 0);

    const img = cx.getImageData(0, 0, w, h);
    const data = img.data;
    const grid = [];
    for (let y = 0; y < h; y++) {
      const row = [];
      for (let x = 0; x < w; x++) {
        row.push(data[(y * w + x) * 4 + 3] > 40 ? 1 : 0);
      }
      grid.push(row);
    }

    // Trim transparent edges
    let minX = w, maxX = 0, minY = h, maxY = 0;
    for (let y = 0; y < h; y++)
      for (let x = 0; x < w; x++)
        if (grid[y][x]) {
          if (x < minX) minX = x;
          if (x > maxX) maxX = x;
          if (y < minY) minY = y;
          if (y > maxY) maxY = y;
        }
    const trimmed = [];
    for (let y = minY; y <= maxY; y++) {
      const row = [];
      for (let x = minX; x <= maxX; x++) row.push(grid[y][x]);
      trimmed.push(row);
    }
    return { grid: trimmed, cols: maxX - minX + 1, rows: maxY - minY + 1 };
  }

  /* ──────── INIT ──────── */
  function initAsciiGlobe() {
    const el = /** @type {HTMLDivElement} */ (document.getElementById('ascii-globe'));
    if (!el) return;

    const ACCENT = el.dataset.accent || '#34d399';
    const GRAY   = el.dataset.gray || '#6b7280';
    const FONT   = el.dataset.font || 'JetBrains Mono';
    const FIRST_FONT = parseInt(el.dataset.firstFont) || 45;
    const BASE_FONT  = parseInt(el.dataset.baseFont) || 18;
    const BLOCK_RATIO = parseFloat(el.dataset.blockRatio) || 0.88;
    const BLOCK_SCALE = parseFloat(el.dataset.blockScale) || 1;
    const PIXEL_GAP  = parseInt(el.dataset.pixelGap) || 1;
    const ROW_GAP_RATIO = parseFloat(el.dataset.rowGapRatio) || 0.6;
    const STAGGER_MS = parseInt(el.dataset.staggerMs) || 60;

    let grid1 = null, grid2 = null;
    let cols1 = 0, rows1 = 0, cols2 = 0, rows2 = 0;
    let line1 = null, line2 = null;
    let timeline = null;

    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    const prefersReducedMotion = mq.matches;

    // ─── Build pixel grids ───
    function buildGrids() {
      const r1 = textToGrid('AYMEN', FIRST_FONT, FONT, true);
      const r2 = textToGrid('ben Yedder', BASE_FONT, FONT, false);
      if (r1 && r2) {
        grid1 = r1.grid; cols1 = r1.cols; rows1 = r1.rows;
        grid2 = r2.grid; cols2 = r2.cols; rows2 = r2.rows;
        buildPixels();
        sizeGlobe();
        startAnimations();
      }
    }

    function buildWithFontCheck() {
      if (document.fonts && document.fonts.ready)
        document.fonts.ready.then(buildGrids);
      else buildGrids();
    }
    buildWithFontCheck();

    // ─── Create pixel DOM (row-major so anime.stagger grid indexing works) ───
    function buildPixels() {
      el.innerHTML = '';

      line1 = document.createElement('div');
      line1.className = 'line line1';
      for (let r = 0; r < rows1; r++) {
        for (let c = 0; c < cols1; c++) {
          const p = document.createElement('div');
          p.className = 'pixel';
          p.style.setProperty('--c', String(c));
          p.style.setProperty('--r', String(r));
          p.style.setProperty('--pc', ACCENT);
          if (!grid1[r][c]) p.style.visibility = 'hidden';
          line1.appendChild(p);
        }
      }
      el.appendChild(line1);

      line2 = document.createElement('div');
      line2.className = 'line line2';
      for (let r = 0; r < rows2; r++) {
        for (let c = 0; c < cols2; c++) {
          const p = document.createElement('div');
          p.className = 'pixel';
          p.style.setProperty('--c', String(c));
          p.style.setProperty('--r', String(r));
          p.style.setProperty('--pc', GRAY);
          if (!grid2[r][c]) p.style.visibility = 'hidden';
          line2.appendChild(p);
        }
      }
      el.appendChild(line2);
    }

    // ─── Size globe from pixel grid × container width ───
    function sizeGlobe() {
      if (!grid1 || !grid2 || !line1 || !line2) return;

      // Available width from parent container
      const parent = el.parentElement;
      const cssW = parent ? parent.clientWidth : el.clientWidth;

      if (cssW <= 0) {
        setTimeout(sizeGlobe, 100);
        return;
      }

      // Compute block sizes from container width
      const baseBs1 = Math.max(1, Math.floor((cssW * BLOCK_RATIO) / cols1));
      const bs1 = Math.max(1, Math.round(baseBs1 * BLOCK_SCALE));

      const fontRatio = BASE_FONT / FIRST_FONT;
      const bs2 = Math.max(1, Math.round(bs1 * fontRatio));

      const totalW1 = cols1 * bs1;
      const totalW2 = cols2 * bs2;
      const canvasW = Math.max(totalW1, totalW2);
      const rowGap = Math.round(bs1 * ROW_GAP_RATIO);
      const canvasH = rows1 * bs1 + rowGap + rows2 * bs2;

      // Center each line horizontally
      const ox = (canvasW - Math.max(totalW1, totalW2)) / 2;
      const ox1 = ox + (Math.max(totalW1, totalW2) - totalW1) / 2;
      const ox2 = ox + (Math.max(totalW1, totalW2) - totalW2) / 2;
      const oy2 = rows1 * bs1 + rowGap;

      el.style.setProperty('--bs1', bs1 + 'px');
      el.style.setProperty('--bs2', bs2 + 'px');
      el.style.setProperty('--gap', PIXEL_GAP + 'px');
      el.style.width = canvasW + 'px';
      el.style.height = canvasH + 'px';

      line1.style.left = ox1 + 'px';
      line1.style.top = '0px';
      line2.style.left = ox2 + 'px';
      line2.style.top = oy2 + 'px';
    }

    // ─── Animate with Anime.js v3 (MCP stagger-grid + timeline patterns) ───
    function startAnimations() {
      if (prefersReducedMotion) {
        anime.set('.ascii-globe .pixel', { opacity: 1, scale: 1, translateY: 0 });
        return;
      }

      timeline = anime.timeline({
        easing: 'easeOutExpo',
        duration: 750
      });

      // AYMEN — pop in from center with bounce
      timeline.add({
        targets: '.ascii-globe .line1 .pixel',
        scale: [0, 1],
        opacity: [0, 1],
        translateY: [50, 0],
        delay: anime.stagger(STAGGER_MS, { grid: [cols1, rows1], from: 'center' }),
        easing: 'easeOutBack'
      }).add({
        // ben Yedder — follows, overlapping the tail of AYMEN
        targets: '.ascii-globe .line2 .pixel',
        scale: [0, 1],
        opacity: [0, 1],
        translateY: [50, 0],
        delay: anime.stagger(STAGGER_MS, { grid: [cols2, rows2], from: 'center' }),
        easing: 'easeOutBack'
      }, '-=600');
    }

    // Re-layout on resize (debounced)
    let resizeTimer = 0;
    const ro = new ResizeObserver(() => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => sizeGlobe(), 120);
    });
    ro.observe(el.parentElement);

    document.addEventListener('astro:before-swap', () => {
      if (timeline) timeline.pause();
      anime.remove('.ascii-globe .pixel');
      ro.disconnect();
    }, { once: true });
  }

  let _initialised = false;
  function safe() {
    if (_initialised) return;
    _initialised = true;
    try { initAsciiGlobe(); } catch (_) {}
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', safe);
  else safe();
  document.addEventListener('astro:page-load', safe);
</script>